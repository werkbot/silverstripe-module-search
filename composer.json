{
  "name": "werkbot/werkbot-search",
  "description": "Provides search functionality with TNTSearch",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "homepage": "https://github.com/werkbot/silverstripe-module-search",
  "require": {
    "php": "^8.5",
    "silverstripe/cms": "^6",
    "silverstripe/framework": "^6",
    "teamtnt/tntsearch": "dev-master",
    "ext-sqlite3": "*",
    "symbiote/silverstripe-queuedjobs": "^6.1"
  },
  "require-dev": {
    "code-lts/doctum": "^5.5",
    "wernerkrauss/silverstripe-rector": "^1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Werkbot\\Search\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
